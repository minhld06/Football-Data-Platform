FOOTBALL_DATA_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here

# Timezone used to name raw files when crawling via Docker (crawlers service).
# Change based on where the crawl is running, e.g. "Europe/Paris" if crawling from France.
TZ=Asia/Ho_Chi_Minh

POSTGRES_DB=football
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_password_here

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_password_here

FRONTEND_ORIGIN=http://localhost:3000